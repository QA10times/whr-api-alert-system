{
  "name": "whr-alerts-backend",
  "version": "1.0.0",
  "private": true,
  "description": "WHR API Alert System backend (NestJS 10, TypeORM, PostgreSQL 16)",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/copy-assets.js",
    "start": "node dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "migrate": "node dist/database/run-migrations.js",
    "migrate:dev": "ts-node src/database/run-migrations.ts",
    "db:dev": "ts-node scripts/dev-db.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/throttler": "5.2.0",
    "@nestjs/typeorm": "10.0.2",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "^16.4.7",
    "handlebars": "4.7.8",
    "helmet": "7.2.0",
    "joi": "17.13.3",
    "nodemailer": "6.9.16",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "undici": "6.21.0"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.22",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.10",
    "@types/nodemailer": "6.4.17",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "6.0.2",
    "embedded-postgres": "16.11.0-beta.16",
    "jest": "29.7.0",
    "rimraf": "5.0.10",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/src/**/*.spec.ts"
        ]
      },
      {
        "displayName": "integration",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "rootDir": ".",
        "testMatch": [
          "<rootDir>/test/**/*.int-spec.ts"
        ],
        "globalSetup": "<rootDir>/test/global-setup.ts",
        "globalTeardown": "<rootDir>/test/global-teardown.ts"
      }
    ]
  }
}
