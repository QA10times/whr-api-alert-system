# Local development without Docker: copy to backend/.env.
# `npm run db:dev` starts PostgreSQL 16 (embedded-postgres) with these DB_* values.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3001
CORS_ORIGIN=
AUTH_USERS={"admin@example.com":"ChangeMe#1"}
JWT_SECRET=replace-with-64-random-chars
JWT_EXPIRES_IN=12h
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alerts
DB_USER=alerts
DB_PASSWORD=alerts-dev
# openssl rand -base64 32
ENCRYPTION_KEY=base64-32-byte-key
# empty: alert emails are written to the log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="WHR Alerts <alerts@example.com>"
RUNNER_ENABLED=true
RUNNER_TICK_MS=15000
ALERT_SEND_RECOVERY=true
ALERT_TIMEZONE=Asia/Kolkata
SECRET_ACCESS_RATE_PER_MIN=30
RUN_RETENTION_DAYS=30
