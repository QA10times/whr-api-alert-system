# Copy to .env and fill in. Read by docker-compose (api via env_file; db and web via substitution).
# Commit only this file. Comments stay on their own lines so every Compose version parses values cleanly.

# ---------- Web (Next.js) ----------
# "false" only for plain-http local runs
COOKIE_SECURE=true

# ---------- App ----------
NODE_ENV=production
PORT=3000
# used for links in alert emails
APP_BASE_URL=https://alerts.10times.internal
# only used if a browser calls the API directly
CORS_ORIGIN=

# ---------- Auth (email = key, password = value) ----------
# bcrypt hashes are also accepted as values: "$2b$12$...."
AUTH_USERS={"admin@example.com":"ChangeMe#1","ops@example.com":"ChangeMe#2"}
JWT_SECRET=replace-with-64-random-chars
JWT_EXPIRES_IN=12h

# ---------- Database ----------
DB_HOST=db
DB_PORT=5432
DB_NAME=alerts
DB_USER=alerts
DB_PASSWORD=replace-me

# ---------- Encryption of stored API credentials ----------
# openssl rand -base64 32   (boot fails until this is a real 32-byte key)
ENCRYPTION_KEY=base64-32-byte-key

# ---------- Mail ----------
# Leave SMTP_HOST empty in local dev to write alert emails to the log instead of sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASSWORD=app-password
MAIL_FROM="WHR Alerts <alerts@example.com>"

# ---------- Runner ----------
RUNNER_ENABLED=true
RUNNER_TICK_MS=15000
DEFAULT_FREQUENCY_MINUTES=5
DEFAULT_FAILURE_THRESHOLD=5
DEFAULT_TIMEOUT_MS=15000
ALERT_SEND_RECOVERY=true
ALERT_TIMEZONE=Asia/Kolkata
# copy curl + reveal credentials, per user
SECRET_ACCESS_RATE_PER_MIN=30
RUN_RETENTION_DAYS=30
