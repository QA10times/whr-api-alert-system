# ---- web (Next.js) ----
API_INTERNAL_URL=http://api:3000
COOKIE_SECURE=true

# ---- api (NestJS) ---- final list follows the backend design doc
DATABASE_URL=postgres://whr:whr@db:5432/whr
POSTGRES_USER=whr
POSTGRES_PASSWORD=whr
POSTGRES_DB=whr
# email:password pairs, comma separated
AUTH_USERS=admin@example.com:change-me
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=43200
# key used to encrypt stored credentials
CREDENTIALS_KEY=change-me-32-bytes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM="WHR Alerts <alerts@example.com>"
DASHBOARD_URL=http://localhost:8080
